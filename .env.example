JWT_SECRET=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
OPENAI_API_KEY=
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4o-mini
# Recommended for public deployment: a developer-owned embedding connection.
# Falls back to OPENAI_API_KEY / OPENAI_BASE_URL when left blank.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# Docker Compose overrides this to queue. Use inline for direct local debugging.
TASK_MODE=inline
REDIS_URL=redis://redis:6379/0
ANALYSIS_JOB_TIMEOUT_SECONDS=240
# Optional: developer console cost estimate for the configured chat model.
CHAT_INPUT_COST_PER_MILLION=0
CHAT_OUTPUT_COST_PER_MILLION=0
# Only developers can call knowledge package management APIs.
KNOWLEDGE_ADMIN_KEY=replace-with-a-random-admin-secret
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-a-separate-random-secret
LOCAL_WORKSPACE_MODE=true
# Public no-login deployment: set LOCAL_WORKSPACE_MODE=false and this=true.
ANONYMOUS_WORKSPACE_MODE=false
WORKSPACE_COOKIE_NAME=jobpilot_workspace
WORKSPACE_COOKIE_SECURE=false
WORKSPACE_TTL_DAYS=30
# The Render image serves the compiled React app from FastAPI.
SERVE_FRONTEND=false
STATIC_DIR=/app/frontend-dist
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=8
